# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (required) ---
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Quran Foundation API (required for Quran/tafsir/audio content) ---
# https://api-docs.quran.foundation
QF_API_BASE=https://apis.quran.foundation
QF_OAUTH_URL=https://oauth2.quran.foundation
QF_CLIENT_ID=your_qf_client_id
QF_CLIENT_SECRET=your_qf_client_secret

# --- App URL (used for building absolute API URLs server-side) ---
# Comma-separated list of allowed origins, e.g. http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Admin access ---
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=

# --- Rate limiting (optional — falls back to in-memory limiting if unset) ---
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Journey caching (optional) ---
JOURNEY_CACHE_TTL_SECONDS=
NEXT_PUBLIC_JOURNEY_DEBUG=

# --- Bundle analysis (optional) ---
# Set to true to run `next build` with the bundle analyzer
ANALYZE=false
